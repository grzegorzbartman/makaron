#!/bin/bash

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAKARON_PATH="${MAKARON_PATH:-$(cd "$SCRIPT_DIR/.." && pwd)}"

# shellcheck source=bin/makaron-ui-helpers
source "$SCRIPT_DIR/makaron-ui-helpers"

case "${1:-}" in
    on) value=true ;;
    off) value=false ;;
    toggle)
        if [ "$(_get_borders_enabled)" = "true" ]; then
            value=false
        else
            value=true
        fi
        ;;
    *)
        echo "Usage: makaron-borders on|off|toggle" >&2
        exit 2
        ;;
esac

set_makaron_conf_value BORDERS_ENABLED "$value"
[ "$value" = "true" ] && echo "Borders enabled" || echo "Borders disabled"
MAKARON_APPLY_VERBOSE=1 apply_desktop_state

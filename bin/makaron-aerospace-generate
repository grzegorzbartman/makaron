#!/bin/bash
# Merge the base AeroSpace config with the user's overrides into the
# generated file that ~/.aerospace.toml points at. Never exits nonzero:
# a broken user file falls back to the base config (status file records why).
#
# User file format (multi-line arrays / inline tables are fine):
#   key = value                       top-level or inside [table] - user wins
#   [table] / [[on-window-detected]]  user tables merge, user rules run
#   on-window-detected = [ {...} ]    before base routing/float rules
# The [gaps] block is managed by makaron-gaps and cannot be overridden here.

MAKARON_PATH="${MAKARON_PATH:-$HOME/.local/share/makaron}"
MAKARON_CONF_PATH="${MAKARON_CONF_PATH:-$HOME/.config/makaron/makaron.conf}"
BASE="${MAKARON_AEROSPACE_BASE:-$MAKARON_PATH/configs/aerospace/.aerospace.toml}"
USER_FILE="${MAKARON_AEROSPACE_USER_FILE:-$HOME/.config/makaron/aerospace.user.toml}"
GEN_DIR="${MAKARON_GENERATED_DIR:-$HOME/.config/makaron/generated}"
OUT="$GEN_DIR/aerospace.toml"
STATUS_FILE="${MAKARON_AEROSPACE_STATUS_FILE:-$HOME/.local/state/makaron/aerospace-generate.status}"

mkdir -p "$GEN_DIR" "$(dirname "$STATUS_FILE")"

if [ ! -f "$BASE" ]; then
    echo "  ⚠️  AeroSpace base config missing: $BASE" >&2
    exit 0
fi

# Prints "<drop dwindle 0|1> <focus-follows-mouse true|false>" from makaron.conf
_conf_flags() {
    (
        AEROSPACE_AUTO_DWINDLE=true AEROSPACE_FOCUS_FOLLOWS_MOUSE=false
        [ -f "$MAKARON_CONF_PATH" ] && source "$MAKARON_CONF_PATH"
        [ "${AEROSPACE_AUTO_DWINDLE:-true}" = "false" ] && printf '1 ' || printf '0 '
        [ "${AEROSPACE_FOCUS_FOLLOWS_MOUSE:-false}" = "true" ] && echo true || echo false
    )
}

read -r DROP_DWINDLE FOCUS_FOLLOWS_MOUSE <<< "$(_conf_flags)"
USER_INPUT="$USER_FILE"
[ -f "$USER_FILE" ] || USER_INPUT=/dev/null

tmp=$(mktemp "$GEN_DIR/.aerospace.toml.XXXXXX") || exit 0

{
    echo "# GENERATED by Makaron - do not edit this file."
    echo "# Edit ~/.config/makaron/aerospace.user.toml instead,"
    echo "# then run: makaron-reload-aerospace-sketchybar"
    echo ""
} > "$tmp"

merge() {
    awk -v drop_dwindle="$DROP_DWINDLE" -v ffm="$FOCUS_FOLLOWS_MOUSE" -v ufile="$USER_INPUT" '
    function trimkey(s) { sub(/\n.*$/, "", s); sub(/[ \t]*=.*$/, "", s); gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    # Bracket balance of one line, ignoring strings and comments
    function net(s,  t, n) {
        t = s; gsub(/"([^"\\]|\\.)*"/, "", t); gsub(/'\''[^'\'']*'\''/, "", t); sub(/#.*$/, "", t)
        n = gsub(/[\[{]/, "", t); n -= gsub(/[\]}]/, "", t); return n
    }
    # A rule array is never a valid table key, so accept it below any header
    function user_kv(s,  key, id) {
        key = trimkey(s)
        if (key == "on-window-detected") { split_rules(s); return }
        if (in_aot) { aot[aot_n] = aot[aot_n] "\n" s; return }
        id = sec SUBSEP key
        if (!(id in u_val)) u_keys[sec] = u_keys[sec] SUBSEP key
        u_val[id] = s
    }
    function rule_kv(kv) {
        gsub(/^[ \t\n]+|[ \t\n]+$/, "", kv)
        if (kv != "") aot[aot_n] = aot[aot_n] "\n" kv
    }
    # on-window-detected = [ { k = v, ... }, ... ] -> [[on-window-detected]] blocks
    function split_rules(s,  n, i, c, q, d, cur) {
        s = substr(s, index(s, "=") + 1); n = length(s); q = ""; d = 0; cur = ""
        for (i = 1; i <= n; i++) {
            c = substr(s, i, 1)
            if (q != "") {
                cur = cur c
                if (q == "\"" && c == "\\") { i++; cur = cur substr(s, i, 1) }
                else if (c == q) q = ""
                continue
            }
            if (c == "#") { while (i < n && substr(s, i + 1, 1) != "\n") i++; continue }
            if (c == "\"" || c == "'\''") { if (d < 2) { bad = 1; return }; q = c; cur = cur c; continue }
            if (c == "[" || c == "{") {
                d++
                if ((d == 1 && c != "[") || (d == 2 && c != "{")) { bad = 1; return }
                if (d == 2) { aot[++aot_n] = "[[on-window-detected]]"; cur = "" }
                if (d > 2) cur = cur c
                continue
            }
            if (c == "]" || c == "}") {
                d--
                if (d < 0) { bad = 1; return }
                if (d == 1) { rule_kv(cur); cur = "" }
                if (d > 1) cur = cur c
                continue
            }
            if (d == 2 && c == ",") { rule_kv(cur); cur = ""; continue }
            if (d >= 2) { cur = cur c; continue }
            if (c !~ /[ \t\n,]/) { bad = 1; return }
        }
        if (d != 0 || q != "") bad = 1
    }
    function flush_extras(sec,  n, parts, i, id) {
        n = split(u_keys[sec], parts, SUBSEP)
        for (i = 1; i <= n; i++) {
            id = sec SUBSEP parts[i]
            if (parts[i] != "" && !(id in used)) { print u_val[id]; used[id] = 1 }
        }
    }
    function emit_user_sections(  i, sec) {
        for (i = 1; i <= u_sec_n; i++) {
            sec = u_sec_order[i]
            if (sec in base_seen || sec == "[gaps]") continue
            print ""; print sec
            flush_extras(sec)
        }
    }
    BEGIN { sec = "" }
    FILENAME == ufile {
        if ($0 ~ /'\'''\'''\''|"""/) { bad = 1; next }
        if (pend_d > 0) {
            pend = pend "\n" $0; pend_d += net($0)
            if (pend_d < 0) bad = 1
            else if (pend_d == 0) user_kv(pend)
            next
        }
        if ($0 ~ /^[ \t]*$/ || $0 ~ /^[ \t]*#/) { if (in_aot) aot[aot_n] = aot[aot_n] "\n" $0; next }
        if ($0 ~ /^[ \t]*\[\[.*\]\][ \t]*$/) {
            if ($0 !~ /^[ \t]*\[\[on-window-detected\]\][ \t]*$/) { bad = 1; next }
            aot_n++; aot[aot_n] = "[[on-window-detected]]"; in_aot = 1; next
        }
        if ($0 ~ /^[ \t]*\[[^\[].*\][ \t]*$/) {
            in_aot = 0; sec = $0; gsub(/^[ \t]+|[ \t]+$/, "", sec)
            if (!(sec in u_sec_seen)) { u_sec_seen[sec] = 1; u_sec_order[++u_sec_n] = sec }
            next
        }
        if ($0 ~ /^[ \t]*[^ \t=#\[][^=]*=/) {
            pend_d = net($0)
            if (pend_d < 0) bad = 1
            else if (pend_d > 0) pend = $0
            else user_kv($0)
            next
        }
        bad = 1; next
    }
    # ---- base file ----
    {
        if (FNR == 1) { sec = ""; if (pend_d > 0) bad = 1 }
        if (bad) next
        if (aot_region) {
            if ($0 ~ /^\[\[on-window-detected\]\][ \t]*$/) { b_n++; b_aot[b_n] = $0 }
            else if (b_n > 0) b_aot[b_n] = b_aot[b_n] "\n" $0
            next
        }
        if (swallow > 0) { swallow += net($0); next }
        if ($0 ~ /^\[\[on-window-detected\]\][ \t]*$/) {
            flush_extras(sec)
            emit_user_sections()
            aot_region = 1; b_n = 1; b_aot[1] = $0
            next
        }
        if ($0 ~ /^\[[^\[].*\][ \t]*$/) {
            flush_extras(sec)
            sec = $0; gsub(/[ \t]+$/, "", sec)
            base_seen[sec] = 1
            print
            next
        }
        if ($0 ~ /^[ \t]*[^ \t=#\[][^=]*=/ ) {
            key = trimkey($0); id = sec SUBSEP key
            if (sec == "[gaps]") {
                if (id in u_val) gaps_warn = 1
                used[id] = 1
                print
                next
            }
            if (id in u_val) {
                print u_val[id]; used[id] = 1
                swallow = net($0)
                if (swallow < 0) swallow = 0
                next
            }
            if (sec == "" && key == "focus-follows-mouse.enabled") { print key " = " ffm; next }
        }
        print
    }
    END {
        if (bad) exit 3
        if (!aot_region) { flush_extras(sec); emit_user_sections() }
        else {
            start = 1
            if (b_aot[1] ~ /auto-dwindle/) {
                start = 2
                if (!drop_dwindle) print b_aot[1]
            }
            for (i = 1; i <= aot_n; i++) { print ""; print aot[i] }
            for (i = start; i <= b_n; i++) print b_aot[i]
        }
        if (gaps_warn) print "makaron: [gaps] overrides are ignored - use makaron-gaps" > "/dev/stderr"
    }
    ' "$USER_INPUT" "$BASE"
}

if merge >> "$tmp" 2>/tmp/makaron_aerospace_generate_err_$$; then
    grep -v '^$' /tmp/makaron_aerospace_generate_err_$$ >&2 || true
    STATUS="ok"
else
    # Broken user file: regenerate from base only so the WM always has a config
    {
        echo "# GENERATED by Makaron (base only - aerospace.user.toml was invalid)"
        echo ""
        cat "$BASE"
    } > "$tmp"
    STATUS="fallback user-toml-parse-error"
    echo "  ⚠️  ~/.config/makaron/aerospace.user.toml is invalid - using base config only" >&2
    echo "     Allowed: 'key = value', [tables], [[on-window-detected]] or on-window-detected = [ {...} ]" >&2
fi
rm -f /tmp/makaron_aerospace_generate_err_$$

[ -f "$OUT" ] && cp "$OUT" "$OUT.lastgood"
mv "$tmp" "$OUT"
chmod 644 "$OUT"
echo "$STATUS" > "$STATUS_FILE"

# Re-apply gaps/outer.top to the fresh file (base carries template values)
if [ "$(readlink "$HOME/.aerospace.toml" 2>/dev/null)" = "$OUT" ] &&
    [ -f "$MAKARON_PATH/bin/makaron-ui-helpers" ]; then
    # shellcheck source=/dev/null
    source "$MAKARON_PATH/bin/makaron-ui-helpers"
    apply_desktop_state >/dev/null 2>&1 || true
fi

# Validate with AeroSpace when it is running; roll back a rejected merge
if [ "$STATUS" = "ok" ] && [ "$USER_INPUT" != "/dev/null" ] &&
    command -v aerospace >/dev/null 2>&1 && pgrep -f AeroSpace >/dev/null 2>&1; then
    if [ "$(readlink "$HOME/.aerospace.toml" 2>/dev/null)" = "$OUT" ] &&
        ! aerospace reload-config --dry-run --no-gui >/dev/null 2>&1; then
        if [ -f "$OUT.lastgood" ]; then
            cp "$OUT.lastgood" "$OUT"
        else
            { echo "# GENERATED by Makaron (base only - merged config was rejected)"; echo ""; cat "$BASE"; } > "$OUT"
        fi
        echo "fallback reload-rejected" > "$STATUS_FILE"
        echo "  ⚠️  AeroSpace rejected the merged config - reverted to the previous one" >&2
        echo "     Check ~/.config/makaron/aerospace.user.toml for invalid keys/commands" >&2
    fi
fi

exit 0

# Makaron configuration file
# ~/.config/makaron/makaron.conf

# Battery low threshold (percentage)
BATTERY_LOW_THRESHOLD=20

# SketchyBar: hide CPU / memory / storage widgets (more room for workspaces)
SKETCHYBAR_COMPACT_MODE=false

# SketchyBar: hide empty AeroSpace workspaces from the bar
# The focused workspace is always drawn, even if it's empty.
SKETCHYBAR_HIDE_EMPTY_WORKSPACES=true

# Layout profile: auto | desktop | laptop
# auto picks "laptop" when the built-in display is the only screen and is
# narrower than 1600 pt (MacBook Neo, Air 13, Pro 14 at default scaling);
# plugging in a monitor switches back to "desktop" automatically.
MAKARON_LAYOUT_PROFILE=auto

# Window layout: gap between windows in px (0-40)
AEROSPACE_GAP_SIZE=12
AEROSPACE_GAP_SIZE_LAPTOP=6

# Accordion: px the active window is inset so the stacked ones peek out (0-100)
AEROSPACE_ACCORDION_PADDING=30
AEROSPACE_ACCORDION_PADDING_LAPTOP=12

# Laptop profile: tiles allowed side by side; one more flips the workspace to
# accordion (a stack), back under the limit it returns to tiles. 0 = off.
AEROSPACE_LAPTOP_MAX_TILES=2

# SketchyBar height in px (20-80). Window layout adapts automatically.
# The laptop bar is flat and edge to edge; at 32 it fills the notch strip
# exactly, so windows lose no space to it.
SKETCHYBAR_HEIGHT=40
SKETCHYBAR_HEIGHT_LAPTOP=32

# SketchyBar: show the Makaron menu (M mark, click for actions) on the left
SKETCHYBAR_LOGO=true


# SketchyBar: storage / CPU / memory labels turn the alert color above these thresholds (%)
STORAGE_ALERT_THRESHOLD=90
CPU_ALERT_THRESHOLD=80
MEMORY_ALERT_THRESHOLD=80

# Auto-arrange new windows in a dwindle layout (set false to disable)
AEROSPACE_AUTO_DWINDLE=true

# Focus follows mouse: the window under the pointer gets focus (true | false)
# Apply with: makaron-reload-aerospace-sketchybar
AEROSPACE_FOCUS_FOLLOWS_MOUSE=false

# Float-all toggle (alt-shift-f) window arrangement: cascade | grid
FLOAT_ALL_LAYOUT=cascade

# Update channel: stable (latest release) or edge (latest main)
MAKARON_CHANNEL=stable
